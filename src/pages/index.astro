---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ServicesSection from "../components/ServicesSection.astro";
import { ProjectFilter } from "../components/ProjectFilter";
import SkillsSection from "../components/SkillsSection.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import { ContactCard } from "../components/ContactCard";
import {
  LinkedInIcon,
  GitHubIcon,
} from "../components/icons/PlatformIcons";
import "../styles/global.css";
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<Layout>
  <Navbar />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-20">
    {/* HERO SECTION - MINIMALIST */}
    <section id="hero" class="pt-6 sm:pt-10 animate-fade-in">
      <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-8 md:gap-12">
        {/* Info */}
        <div class="space-y-5 flex-1 text-left">
          {/* Status Badge */}
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Disponible para proyectos técnicos & consultoría B2B</span>
          </div>

          {/* Main Title & Role */}
          <div class="space-y-2">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
              Brayan Espitia
            </h1>
            <p class="text-base sm:text-lg lg:text-xl font-bold text-foreground/90 font-mono tracking-tight">
              AI Systems Architect <span class="text-primary font-bold">|</span> Full-Stack & Web3 Developer
            </p>
          </div>

          {/* Bio text */}
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed max-w-xl">
            Diseño arquitecturas escalables que combinan <strong class="text-foreground font-semibold">Sistemas de IA & Agentes autónomos</strong>, aplicaciones web de alto rendimiento y ecosistemas descentralizados en <strong class="text-foreground font-semibold">Web3 & Tokenización</strong>.
          </p>

          {/* Action CTAs */}
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#projects"
              id="hero-btn-projects"
              class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-lg bg-foreground text-background text-xs sm:text-sm font-semibold hover:opacity-90 active:scale-95 transition shadow-xs"
            >
              <span>Ver Proyectos</span>
              <span>📂</span>
            </a>
            
            <a
              href="https://www.linkedin.com/in/brayan-espitia-615ab3127"
              target="_blank"
              rel="noopener noreferrer"
              id="hero-btn-linkedin-main"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#0A66C2] text-white text-xs sm:text-sm font-semibold hover:opacity-90 active:scale-95 transition shadow-xs"
            >
              <LinkedInIcon className="w-4 h-4 text-white" />
              <span>Conectar en LinkedIn</span>
              <span class="text-xs">↗</span>
            </a>

            <a
              href="https://github.com/Brayan10j"
              target="_blank"
              rel="noopener noreferrer"
              id="hero-btn-github"
              class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-lg text-muted-foreground hover:text-foreground bg-secondary/60 hover:bg-secondary text-xs sm:text-sm font-medium border border-border/50 transition"
              title="GitHub (@Brayan10j)"
              aria-label="GitHub"
            >
              <GitHubIcon className="w-4 h-4" />
              <span>GitHub</span>
            </a>
          </div>
        </div>

        {/* Profile Avatar Minimal */}
        <div class="shrink-0">
          <div class="relative group">
            <img
              src="/profile.jpeg"
              alt="Brayan Espitia"
              class="rounded-2xl w-32 h-32 sm:w-40 sm:h-40 object-cover border border-border/80 shadow-sm"
              loading="eager"
            />
            <div class="absolute -bottom-2 -right-2 bg-background border border-border/80 px-2 py-0.5 rounded-md text-xs font-mono text-muted-foreground shadow-xs">
              🇨🇴 Colombia
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SOBRE MÍ / FOCUS MINIMAL */}
    <section id="about" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-100">
      <div class="border-t border-border/50 pt-10">
        <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground mb-4">
          01 / Enfoque Profesional
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-2 p-4 rounded-xl border border-border/50 bg-secondary/15 hover:border-primary/30 transition">
            <div class="flex items-center gap-2 text-foreground font-semibold">
              <span class="text-xl">🧠</span>
              <h3 class="text-sm font-bold">AI Systems & Agentes</h3>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Diseño de sistemas LLM, orquestación de agentes autónomos, extractores documentales con visión, pipelines RAG y automatizaciones complejas con n8n y LangChain.
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-xl border border-border/50 bg-secondary/15 hover:border-primary/30 transition">
            <div class="flex items-center gap-2 text-foreground font-semibold">
              <span class="text-xl">💻</span>
              <h3 class="text-sm font-bold">FullStack Escalable</h3>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Desarrollo frontend y backend con Next.js (App Router), TypeScript, React, Node.js y bases de datos relacionales (PostgreSQL, Supabase, Cloud SQL).
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-xl border border-border/50 bg-secondary/15 hover:border-primary/30 transition">
            <div class="flex items-center gap-2 text-foreground font-semibold">
              <span class="text-xl">⛓️</span>
              <h3 class="text-sm font-bold">Blockchain & Web3</h3>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Smart contracts seguros en Solidity, tokenización de Real World Assets (RWA), pasarelas de pago Web3 y arquitecturas multicadena auditables.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SERVICES SECTION */}
    <section id="services" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-150">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            02 / Servicios & Soluciones B2B
          </h2>
          <span class="text-xs text-muted-foreground font-mono">IA, Infraestructura & Web3</span>
        </div>

        <ServicesSection />
      </div>
    </section>

    {/* SKILLS SECTION */}
    <section id="skills" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-200">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            03 / Stack Tecnológico
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Herramientas & Frameworks</span>
        </div>

        <SkillsSection />
      </div>
    </section>

    {/* PROJECTS SECTION */}
    <section id="projects" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-300">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            04 / Proyectos Destacados
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Producción, AI & Web3</span>
        </div>

        <ProjectFilter client:load />
      </div>
    </section>

    {/* EXPERIENCE SECTION */}
    <section id="experience" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-400">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            05 / Trayectoria & Hitos
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Verificado en LinkedIn</span>
        </div>

        <ExperienceTimeline />
      </div>
    </section>

    {/* CONTACT SECTION */}
    <section id="contact" class="scroll-mt-24 space-y-6">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            06 / Contacto Directo
          </h2>
          <span class="text-xs text-muted-foreground font-mono">LinkedIn</span>
        </div>

        <ContactCard client:load />
      </div>
    </section>
  </main>

  {/* FOOTER */}
  <footer class="border-t border-border/40 py-8 mt-16 text-center text-xs text-muted-foreground">
    <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>
        © 2026 <span class="text-foreground font-medium">Brayan Espitia</span> · <span class="font-mono text-xs">AI Systems Architect | Full-Stack & Web3</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="#hero" class="hover:text-foreground transition flex items-center gap-1">
          <span>Inicio</span>
          <span>⚡</span>
        </a>
        <a
          href="https://github.com/Brayan10j"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition flex items-center gap-1.5"
        >
          <GitHubIcon className="w-3.5 h-3.5" />
          <span>GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/in/brayan-espitia-615ab3127"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition flex items-center gap-1.5"
        >
          <LinkedInIcon className="w-3.5 h-3.5 text-[#0A66C2]" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </footer>
</Layout>
