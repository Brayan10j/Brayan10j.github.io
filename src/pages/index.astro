---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { ProjectFilter } from "../components/ProjectFilter";
import SkillsSection from "../components/SkillsSection.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import { ContactCard } from "../components/ContactCard";
import "../styles/global.css";
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<Layout>
  <Navbar />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-20">
    {/* HERO SECTION - MINIMALIST */}
    <section id="hero" class="pt-6 sm:pt-10 animate-fade-in">
      <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-8 md:gap-12">
        {/* Info */}
        <div class="space-y-5 flex-1 text-left">
          {/* Status Badge */}
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/80 text-foreground text-xs font-medium border border-border/60">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Disponible para nuevos proyectos & roles</span>
          </div>

          {/* Main Title & Role */}
          <div class="space-y-2">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
              Brayan Espitia
            </h1>
            <p class="text-lg sm:text-xl font-semibold text-muted-foreground">
              AI Systems Architect <span class="text-border">/</span> FullStack Developer <span class="text-border">/</span> Blockchain
            </p>
          </div>

          {/* Bio text */}
          <p class="text-base text-muted-foreground leading-relaxed max-w-xl">
            Especializado en diseñar arquitecturas escalables que combinan <strong class="text-foreground font-medium">Sistemas de IA</strong>, aplicaciones web modernas de alto rendimiento y ecosistemas descentralizados en <strong class="text-foreground font-medium">Web3 & Blockchain</strong>.
          </p>

          {/* Action CTAs */}
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#projects"
              id="hero-btn-projects"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-foreground text-background text-sm font-semibold hover:opacity-90 active:scale-95 transition"
            >
              <span>Ver Proyectos</span>
              <span>📂</span>
            </a>
            <a
              href="#contact"
              id="hero-btn-contact"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-secondary text-secondary-foreground text-sm font-medium border border-border/70 hover:bg-secondary/80 active:scale-95 transition"
            >
              <span>Contactar</span>
              <span>✉️</span>
            </a>
            <div class="flex items-center gap-2">
              <a
                href="https://github.com/Brayan10j"
                target="_blank"
                rel="noopener noreferrer"
                id="hero-btn-github"
                class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary/60 text-sm font-medium transition"
                title="GitHub"
              >
                <span>🐙</span>
                <span class="text-xs">GitHub</span>
              </a>
              <a
                href="https://www.linkedin.com/in/brayan-espitia-615ab3127/"
                target="_blank"
                rel="noopener noreferrer"
                id="hero-btn-linkedin"
                class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary/60 text-sm font-medium transition"
                title="LinkedIn"
              >
                <span>💼</span>
                <span class="text-xs">LinkedIn</span>
              </a>
            </div>
          </div>
        </div>

        {/* Profile Avatar Minimal */}
        <div class="shrink-0">
          <div class="relative group">
            <img
              src="/profile.jpeg"
              alt="Brayan Espitia"
              class="rounded-2xl w-32 h-32 sm:w-40 sm:h-40 object-cover border border-border/80 shadow-sm"
              loading="eager"
            />
            <div class="absolute -bottom-2 -right-2 bg-background border border-border/80 px-2 py-0.5 rounded-md text-xs font-mono text-muted-foreground shadow-xs">
              🇨🇴 Colombia
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SOBRE MÍ / FOCUS MINIMAL */}
    <section id="about" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-100">
      <div class="border-t border-border/50 pt-10">
        <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground mb-4">
          01 / Enfoque Profesional
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-foreground font-semibold">
              <span>🧠</span>
              <h3>AI Systems & Agentes</h3>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Diseño de sistemas LLM, orquestación de agentes autónomos, pipelines RAG con bases de datos vectoriales y automatizaciones con n8n y LangChain.
            </p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2 text-foreground font-semibold">
              <span>💻</span>
              <h3>FullStack Moderno</h3>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Desarrollo con Next.js (App Router), TypeScript, React, Node.js y bases de datos relacionales como PostgreSQL y Supabase.
            </p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2 text-foreground font-semibold">
              <span>⛓️</span>
              <h3>Blockchain & Web3</h3>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Smart contracts seguros en Solidity, tokenización de Real World Assets (RWA), pasarelas de pago cripto y arquitecturas multicadena.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SKILLS SECTION */}
    <section id="skills" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-200">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            02 / Stack Tecnológico
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Herramientas & Frameworks</span>
        </div>

        <SkillsSection />
      </div>
    </section>

    {/* PROJECTS SECTION */}
    <section id="projects" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-300">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            03 / Proyectos Destacados
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Producción & Web3</span>
        </div>

        <ProjectFilter client:load />
      </div>
    </section>

    {/* EXPERIENCE SECTION */}
    <section id="experience" class="scroll-mt-24 space-y-6 animate-fade-in animation-delay-400">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            04 / Trayectoria
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Experiencia Relevante</span>
        </div>

        <ExperienceTimeline />
      </div>
    </section>

    {/* CONTACT SECTION */}
    <section id="contact" class="scroll-mt-24 space-y-6">
      <div class="border-t border-border/50 pt-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xs uppercase tracking-widest font-mono text-muted-foreground">
            05 / Contacto Directo
          </h2>
          <span class="text-xs text-muted-foreground font-mono">Hablemos</span>
        </div>

        <ContactCard client:load />
      </div>
    </section>
  </main>

  {/* FOOTER */}
  <footer class="border-t border-border/40 py-8 mt-16 text-center text-xs text-muted-foreground">
    <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>
        © 2025 <span class="text-foreground font-medium">Brayan Espitia</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="#hero" class="hover:text-foreground transition">Inicio ⚡</a>
        <a href="https://github.com/Brayan10j" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">GitHub 🐙</a>
        <a href="https://www.linkedin.com/in/brayan-espitia-615ab3127/" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition">LinkedIn 💼</a>
      </div>
    </div>
  </footer>
</Layout>


