---
interface ExperienceItem {
  period: string;
  role: string;
  company: string;
  emoji: string;
  description: string;
  tags: string[];
}

const experiences: ExperienceItem[] = [
  {
    period: "2023 - Presente",
    role: "AI Systems Architect & Web3 Lead",
    company: "Sistemas Autónomos & Soluciones Descentralizadas",
    emoji: "🧠",
    description: "Diseño de arquitecturas inteligentes basadas en LLMs y agentes autónomos con flujos RAG. Dirección técnica en despliegues Web3, smart contracts multicadena (Sionland, Airballoons) y automatización con n8n.",
    tags: ["AI Systems", "LangChain", "Solidity", "Next.js", "Ethers.js", "Docker", "GCP"],
  },
  {
    period: "2022 - 2023",
    role: "Full Stack Engineer & Cloud Integrator",
    company: "Soluciones Digitales & E-Commerce",
    emoji: "⚡",
    description: "Construcción de marketplaces y plataformas web con Nuxt.js y Supabase (EncuentraTodo), flujos automatizados con n8n y despliegues serverless.",
    tags: ["Nuxt.js", "Supabase", "PostgreSQL", "n8n", "Tailwind CSS"],
  },
  {
    period: "2021 - 2022",
    role: "Frontend & Blockchain Specialist",
    company: "Startups & FinTech",
    emoji: "💳",
    description: "Diseño e implementación de pasarelas de pago cripto (Crypto Pagos App), interfaces reactivas con React/TypeScript y conexión de billeteras Web3.",
    tags: ["React", "TypeScript", "Web3.js", "Smart Contracts", "REST APIs"],
  },
];
---

<div class="space-y-8 border-l border-border/50 pl-6 ml-2">
  {experiences.map((exp) => (
    <div class="relative group space-y-2">
      {/* Subtle indicator dot */}
      <div class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-border group-hover:bg-primary transition-colors"></div>

      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="text-sm font-bold text-foreground">
          {exp.role}
        </h3>
        <span class="text-xs font-mono text-muted-foreground">
          {exp.period}
        </span>
      </div>

      <p class="text-xs font-medium text-muted-foreground flex items-center gap-1.5">
        <span>{exp.emoji}</span>
        <span>{exp.company}</span>
      </p>

      <p class="text-xs text-muted-foreground/90 leading-relaxed max-w-2xl pt-1">
        {exp.description}
      </p>

      <div class="flex flex-wrap gap-1 pt-1">
        {exp.tags.map((tag) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-secondary/30 text-muted-foreground border border-border/30 font-mono">
            {tag}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>

