---
import { skillCategories } from "../data/skills";
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  {skillCategories.map((cat) => (
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <span class="text-base">{cat.emoji}</span>
        <h3 class="text-sm font-semibold text-foreground tracking-tight">
          {cat.title}
        </h3>
      </div>

      <p class="text-xs text-muted-foreground leading-normal">
        {cat.description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {cat.skills.map((skill) => (
          <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-mono border transition-colors ${
            skill.highlight
              ? "bg-secondary text-foreground border-border/80 font-medium"
              : "bg-secondary/30 text-muted-foreground border-border/40 hover:text-foreground"
          }`}>
            <span class="text-xs">{skill.emoji}</span>
            <span>{skill.name}</span>
          </span>
        ))}
      </div>
    </div>
  ))}
</div>

