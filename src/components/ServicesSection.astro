---
import { services } from "../data/services";
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
  {services.map((service) => (
    <div class="group flex flex-col justify-between rounded-xl border border-border/60 bg-card p-5 transition hover:border-border hover:shadow-sm">
      <div class="space-y-3">
        {/* Header with Emoji & Category */}
        <div class="flex items-center justify-between gap-2">
          <span class="text-2xl">{service.emoji}</span>
          <span class="text-[10px] font-mono text-muted-foreground bg-secondary/50 px-2 py-0.5 rounded border border-border/40 truncate max-w-[190px]">
            {service.category}
          </span>
        </div>

        {/* Title */}
        <h3 class="text-sm sm:text-base font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
          {service.title}
        </h3>

        {/* Description */}
        <p class="text-xs text-muted-foreground/90 leading-relaxed">
          {service.description}
        </p>
      </div>

      {/* Highlights / Tags */}
      <div class="pt-4 mt-4 border-t border-border/40 flex flex-wrap gap-1">
        {service.highlights.map((tag) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-secondary/40 text-muted-foreground border border-border/30 font-mono">
            {tag}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
